#!/usr/bin/env bash
# Installs HAProxy on a fresh Ubuntu box and configures it to load balance
# HTTP traffic between web-01 and web-02 using a round-robin algorithm.

apt-get update -y
apt-get install -y haproxy

# Let HAProxy be managed as a service (init script)
sed -i 's/ENABLED=0/ENABLED=1/' /etc/default/haproxy

# Append the frontend/backend configuration
{
    echo "frontend http_front"
    echo "    bind *:80"
    echo "    stats uri /haproxy?stats"
    echo "    default_backend http_back"
    echo ""
    echo "backend http_back"
    echo "    balance roundrobin"
    echo "    server 7143-web-01 44.201.180.86:80 check"
    echo "    server 7143-web-02 3.82.249.245:80 check"
} >> /etc/haproxy/haproxy.cfg

service haproxy restart

